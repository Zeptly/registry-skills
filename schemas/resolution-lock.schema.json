{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/resolution-lock/v1alpha1.json",
  "title": "Resolution lock: range -> exact version -> digest. References this registry cannot resolve offline are listed explicitly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "root",
    "resolved",
    "unresolved"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.zeptly.dev/v1alpha1"
    },
    "kind": {
      "const": "ResolutionLock"
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "registry": {
          "const": "skills"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry",
          "id",
          "version",
          "digest",
          "directorySeal",
          "maturity",
          "lifecycle"
        ],
        "properties": {
          "registry": {
            "const": "skills"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "directorySeal": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maturity": {
            "enum": [
              "candidate",
              "canonical"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "deprecated",
              "revoked"
            ]
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry",
          "id",
          "version",
          "digest",
          "reason",
          "requestedBy"
        ],
        "properties": {
          "registry": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "enum": [
              "foreign-registry-not-resolved-offline"
            ]
          },
          "requestedBy": {
            "type": "string",
            "description": "Skills-registry id of the referencing artifact."
          }
        }
      }
    }
  }
}
