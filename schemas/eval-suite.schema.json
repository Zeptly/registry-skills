{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/eval-suite/v1.json",
  "title": "Skill evaluation suite (evals/suite.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "zeptly.eval-suite/v1"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "recorded",
            "sandbox",
            "live"
          ],
          "default": "recorded"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "inputs",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "capability",
              "regression",
              "adversarial",
              "safety"
            ],
            "default": "capability"
          },
          "inputs": {
            "type": "object"
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Paths inside evals/ (recorded tool results, documents)."
            }
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "default": 1
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "rubric",
                    "contains",
                    "not-contains",
                    "regex",
                    "json-schema",
                    "tool-called",
                    "tool-not-called",
                    "hitl-requested"
                  ]
                },
                "value": {},
                "criterion": {
                  "type": "string",
                  "description": "For rubric graders: a single checkable statement."
                }
              }
            }
          }
        }
      }
    },
    "graders": {
      "type": "object",
      "description": "Named grader configuration; interpreted by the eval harness, not this repo."
    }
  }
}
