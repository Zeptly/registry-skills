{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/skill-manifest/v1.json",
  "title": "Zeptly Skill Blueprint manifest (zeptly.skill/v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "title", "description", "domain", "version", "status",
               "authorship", "provenance", "compatibility", "requires", "inputs", "outputs",
               "security", "evaluation"],
  "properties": {
    "schema": {"const": "zeptly.skill/v1"},
    "id": {
      "description": "Stable, immutable, globally unique identity. Never derived from path, domain or name changes.",
      "type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80
    },
    "name": {
      "description": "Slug; must equal the directory name and the SKILL.md frontmatter name.",
      "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64
    },
    "title": {"type": "string", "minLength": 3, "maxLength": 100},
    "description": {"type": "string", "minLength": 20, "maxLength": 1024, "pattern": "^[^<>]*$"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "version": {"$ref": "#/$defs/semver"},
    "status": {"enum": ["discovered", "inspected", "candidate", "evaluating", "approved",
                        "rejected", "active", "deprecated", "retired"]},
    "deprecation": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 5},
        "replaced_by": {"$ref": "#/$defs/skillId"},
        "sunset": {"type": "string", "format": "date"}
      }
    },
    "authorship": {
      "type": "object", "additionalProperties": false, "required": ["authors", "maintainers"],
      "properties": {
        "authors": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "kind"],
          "properties": {
            "name": {"type": "string"},
            "kind": {"enum": ["human", "agent", "zep", "organisation"]},
            "contact": {"type": "string"}
          }}},
        "maintainers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^@[A-Za-z0-9_/-]+$"}},
        "license": {"type": "string", "description": "SPDX identifier or LicenseRef-*."}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["origin", "trust_tier"],
      "properties": {
        "origin": {"enum": ["human-authored", "zep-generalised", "external-discovery", "imported", "hybrid"]},
        "trust_tier": {
          "description": "first-party: authored/reviewed by Zeptly. reviewed-third-party: external, inspected and assessed. unreviewed: external, not yet assessed (never valid for active skills).",
          "enum": ["first-party", "reviewed-third-party", "unreviewed"]
        },
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/skillRef"},
          "description": "Prior skill versions this one was derived/forked from."},
        "assessment": {"type": "string", "description": "Path (inside the bundle) to the provenance/security assessment record. Required for external-discovery/imported origins."}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["agent_classes", "protocol"],
      "properties": {
        "protocol": {"type": "integer", "minimum": 1, "description": "Skill Blueprint protocol major the skill targets (this spec = 1)."},
        "agent_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "min_context_tokens": {"type": "integer", "minimum": 1000},
        "model_notes": {"type": "string"},
        "supersedes": {"type": "array", "items": {"$ref": "#/$defs/skillId"},
          "description": "Other skill IDs this skill replaces (merge/split refactors)."}
      }
    },
    "requires": {
      "type": "object", "additionalProperties": false, "required": ["capabilities"],
      "properties": {
        "capabilities": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id"],
          "properties": {"id": {"type": "string", "pattern": "^cap\\.[a-z0-9]+(\\.[a-z0-9-]+)+$"},
                         "optional": {"type": "boolean", "default": false}}}},
        "tools": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["builtin", "mcp", "api", "computer-use", "cli"]},
            "name": {"type": "string"},
            "server": {"type": "string", "description": "MCP server / API provider identifier (not a credential)."},
            "version_constraint": {"type": "string"},
            "optional": {"type": "boolean", "default": false}
          }}}
      }
    },
    "dependencies": {
      "type": "array", "maxItems": 8, "description": "Composition. See docs/COMPOSITION.md.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {
          "id": {"$ref": "#/$defs/skillId"},
          "version": {"type": "string", "description": "Semver range: exact, ^x.y.z, ~x.y.z, or space-separated >=,<,>,<= comparators."},
          "role": {"enum": ["composes", "prerequisite"], "default": "composes"},
          "optional": {"type": "boolean", "default": false}
        }
      }
    },
    "inputs":  {"type": "array", "items": {"$ref": "#/$defs/param"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/param"}},
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "data_sensitivity", "side_effects", "permissions", "authentication", "hitl"],
      "properties": {
        "classification": {"enum": ["low", "moderate", "high", "critical"],
          "description": "Overall risk tier. Derived minimums are enforced by the validator (see docs/SECURITY.md)."},
        "data_sensitivity": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["public", "internal", "confidential", "personal", "regulated"]}},
        "side_effects": {"enum": ["none", "read-external", "write-external", "destructive"]},
        "permissions": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["scope", "access", "reason"],
          "properties": {
            "scope": {"type": "string", "description": "Abstract scope, e.g. 'web:public', 'vcs:repo', 'fs:workspace'."},
            "access": {"enum": ["read", "write", "delete", "execute"]},
            "reason": {"type": "string", "minLength": 5}}}},
        "external_systems": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "kind"],
          "properties": {"name": {"type": "string"}, "kind": {"enum": ["web", "api", "mcp", "saas", "database", "filesystem", "other"]}}}},
        "network": {
          "type": "object", "additionalProperties": false, "required": ["egress"],
          "properties": {"egress": {"enum": ["none", "allowlist", "open"]},
                         "allowed_domains": {"type": "array", "items": {"type": "string"}}}
        },
        "authentication": {
          "type": "object", "additionalProperties": false, "required": ["required"],
          "properties": {
            "required": {"type": "boolean"},
            "methods": {"type": "array", "items": {"enum": ["oauth", "api-key", "service-account", "session-cookie", "user-delegated"]}},
            "credential_handling": {"const": "runtime-injected",
              "description": "Credentials are supplied by the runtime's secret store. Skills MUST NOT contain secrets or secret values."}
          }
        },
        "destructive_operations": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["operation", "reversible"],
          "properties": {"operation": {"type": "string"}, "reversible": {"type": "boolean"}}}},
        "hitl": {
          "type": "object", "additionalProperties": false, "required": ["required"],
          "properties": {
            "required": {"type": "boolean"},
            "triggers": {"type": "array", "items": {"type": "string"}, "description": "Situations where human confirmation is mandatory."}
          }
        }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["suite", "min_pass_rate"],
      "properties": {
        "suite": {"type": "string", "description": "Path (inside bundle) to the eval suite."},
        "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "required_for": {"type": "array", "items": {"enum": ["approved", "active"]}, "default": ["active"]}
      }
    },
    "x": {"type": "object", "description": "Extension namespace; ignored by the core validator. Runtime-specific hints only, never secrets."}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"},
    "skillId": {"type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*$"},
    "skillRef": {"type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$",
                 "description": "Exact, immutable reference: <id>@<semver>."},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "uri"],
      "properties": {
        "kind": {"enum": ["mcp-server", "api", "repository", "documentation", "paper", "human-practice", "execution-evidence", "other"]},
        "uri": {"type": "string"},
        "ref": {"type": "string", "description": "Commit SHA / release tag / doc version pinned at inspection."},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "retrieved_at": {"type": "string", "format": "date"},
        "license": {"type": "string"}
      }
    },
    "param": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["string", "integer", "number", "boolean", "url", "file", "object", "array", "markdown"]},
        "required": {"type": "boolean", "default": true},
        "description": {"type": "string", "minLength": 3},
        "schema": {"type": "object", "description": "Optional JSON Schema for object/array shapes."}
      }
    }
  }
}
