{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/eval-report/v2.json",
  "title": "Eval report (provenance/eval-reports/<version>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "subject",
    "suiteDigest",
    "runner",
    "executedAt",
    "summary"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.zeptly.dev/v1alpha1"
    },
    "kind": {
      "const": "EvaluationReport"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "registry": {
          "const": "skills"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "suiteDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "agentClass": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "passed",
        "passRate"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meanCostUsd": {
          "type": "number"
        },
        "meanLatencyS": {
          "type": "number"
        }
      }
    },
    "caseResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidenceUri": {
            "type": "string",
            "pattern": "^(evidence://|https://)[^\\s]+$"
          }
        }
      }
    }
  }
}
