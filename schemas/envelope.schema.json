{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/envelope/v1alpha1.json",
  "title": "Zeptly Registry Protocol v0.1 common envelope (registry.zeptly.dev/v1alpha1)",
  "description": "Registry-agnostic envelope. `spec` is opaque here; each registry constrains its own spec.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "references",
    "provenance",
    "security",
    "attestations"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.zeptly.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "registry",
        "origin",
        "maturity",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "registry": {
          "$ref": "#/$defs/registryName"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "native",
                "upstream-seed",
                "discovered",
                "refined",
                "evolved"
              ]
            },
            "evolution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sourceRefs"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "discovered",
                    "refined",
                    "generalised"
                  ]
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/reference"
                  }
                }
              }
            }
          }
        },
        "maturity": {
          "enum": [
            "candidate",
            "canonical"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "deprecated",
            "revoked"
          ]
        }
      }
    },
    "spec": {
      "type": "object"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "authors",
        "sourceRefs",
        "transformations"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "human",
                  "agent",
                  "zep",
                  "organisation"
                ]
              },
              "contact": {
                "type": "string"
              }
            }
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSource"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "description"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "actor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "capabilities",
        "approvals"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "registryName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "description": "Structured cross-registry reference. `version` is an exact SemVer or a range; `digest` is null unless pinned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "id",
        "version"
      ],
      "properties": {
        "registry": {
          "$ref": "#/$defs/registryName"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "digestAlgorithm": {
          "const": "zeptly-jcs-v1"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "digest"
            ],
            "properties": {
              "digest": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "digestAlgorithm"
            ]
          }
        }
      ]
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mcp-server",
            "api",
            "repository",
            "documentation",
            "paper",
            "human-practice",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^https?://"
        },
        "ref": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "attestation": {
      "description": "Assessment of an exact subject digest. Invalid when subjectDigest is not the artifact's current digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref",
        "subjectDigest",
        "digestAlgorithm"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "ref": {
          "type": "string",
          "pattern": "^(evidence://[^\\s]+|bundle:[A-Za-z0-9_./-]+)$",
          "description": "evidence://... (opaque, resolved outside this repo) or bundle:<path> (file inside the artifact bundle)."
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "issuedAt": {
          "type": "string",
          "format": "date"
        },
        "digestAlgorithm": {
          "const": "zeptly-jcs-v1"
        },
        "subjectSeal": {
          "$ref": "#/$defs/digest",
          "description": "Skills-registry extension: the directory seal of the attested payload. SKILL.md, evals and examples are outside the artifact digest, so an attestation must also bind the seal."
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "evaluation"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "suite",
              "result"
            ]
          }
        }
      ]
    }
  }
}
