{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/registry-index/v1alpha1.json",
  "title": "Deterministic registry index (derived data, Protocol v0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "registry",
    "digestAlgorithm",
    "domain",
    "entries"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.zeptly.dev/v1alpha1"
    },
    "kind": {
      "const": "RegistryIndex"
    },
    "registry": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "digestAlgorithm": {
      "const": "zeptly-jcs-v1"
    },
    "domain": {
      "enum": [
        "production",
        "synthetic"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry",
          "kind",
          "id",
          "version",
          "digest",
          "digestAlgorithm",
          "maturity",
          "lifecycle",
          "origin",
          "location",
          "domain"
        ],
        "properties": {
          "registry": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "directorySeal": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "digestAlgorithm": {
            "const": "zeptly-jcs-v1"
          },
          "maturity": {
            "enum": [
              "candidate",
              "canonical"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "deprecated",
              "revoked"
            ]
          },
          "origin": {
            "type": "object"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            }
          },
          "domain": {
            "enum": [
              "production",
              "synthetic"
            ]
          },
          "extensions": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "maturity": {
                  "const": "canonical"
                }
              },
              "required": [
                "maturity"
              ]
            },
            "then": {
              "required": [
                "directorySeal"
              ]
            }
          }
        ]
      }
    }
  }
}
