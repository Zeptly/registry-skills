{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/approval/v1.json",
  "title": "Approval record (provenance/approval.yaml)",
  "description": "Human decision authorising a version to be canonical. Either cites an eval report or carries an explicit, visible waiver.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "skill_ref", "approved_by", "approved_at", "basis"],
  "properties": {
    "schema": {"const": "zeptly.approval/v1"},
    "skill_ref": {"type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
    "approved_by": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^@[A-Za-z0-9_/-]+$"}},
    "security_reviewed_by": {"type": "array", "items": {"type": "string", "pattern": "^@[A-Za-z0-9_/-]+$"}},
    "approved_at": {"type": "string", "format": "date"},
    "basis": {"enum": ["eval-report", "waiver"]},
    "eval_report": {"type": "string"},
    "waiver": {
      "type": "object", "additionalProperties": false, "required": ["reason", "expires_on_version"],
      "properties": {"reason": {"type": "string", "minLength": 10},
                     "expires_on_version": {"type": "string", "description": "Waiver is void from this version onwards, e.g. 1.1.0. Forces evals before further evolution."}}
    },
    "notes": {"type": "string"}
  }
}
