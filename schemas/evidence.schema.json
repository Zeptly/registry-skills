{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.zeptly.dev/schemas/evidence/v1.json",
  "title": "Evidence reference file (provenance/evidence.yaml)",
  "description": "Append-only pointers to evidence about a skill. Evidence is referenced, never embedded; raw trajectories live in the evidence system (e.g. AgentGit) and are addressed by opaque URI.",
  "type": "object", "additionalProperties": false, "required": ["schema", "skill", "refs"],
  "properties": {
    "schema": {"const": "zeptly.evidence/v1"},
    "skill": {"type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*$"},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "wisdom", "kind", "skill_ref", "uri", "recorded_at", "summary"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]{2,63}$", "description": "Unique within the file; stable."},
        "wisdom": {"enum": ["crowd", "compute"], "description": "crowd = human-derived; compute = machine-derived execution evidence."},
        "kind": {"enum": ["execution-trajectory", "failure-cluster", "eval-result", "human-correction",
                          "human-preference", "best-practice", "cost-latency-report", "incident"]},
        "skill_ref": {"type": "string", "pattern": "^zsk\\.[a-z0-9]+(-[a-z0-9]+)*@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
                      "description": "Exact skill version the evidence was observed against."},
        "skill_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uri": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:", "description": "Opaque pointer, e.g. agentgit://..., zep://..., https://..."},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "recorded_at": {"type": "string"},
        "summary": {"type": "string", "minLength": 5},
        "supports": {"enum": ["improvement", "regression", "failure-pattern", "confirmation", "new-skill"]},
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
        "agent_classes_observed": {"type": "array", "items": {"type": "string"}, "description": "Cross-agent learning: which classes exhibited this."},
        "n_agents": {"type": "integer", "minimum": 1},
        "n_runs": {"type": "integer", "minimum": 1}
      }
    }
  }
}
